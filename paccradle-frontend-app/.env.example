# Copy to .env.local and fill in. Every NEXT_PUBLIC_ value ships to the browser: no secrets here.

# Your legal name as a sole proprietor. Shown in the Terms and footer (Paddle domain approval).
NEXT_PUBLIC_LEGAL_NAME=

# Support and legal contact address shown on the legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Form endpoint of your email-list tool. Receives a form POST with "email" and "source" fields.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Your site's domain as set up in Plausible. Leave empty to turn analytics off.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: Plausible script URL. Defaults to https://plausible.io/js/script.js (change it when self-hosting).
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=

# Paddle.js checkout (CLAUDE.md §9.3). Paddle.js runs in the browser, and Next.js only sends
# NEXT_PUBLIC_ values there. Client tokens (test_... / live_...) are meant to be public; the
# API key and webhook secret stay in the backend.
# sandbox or production.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxx

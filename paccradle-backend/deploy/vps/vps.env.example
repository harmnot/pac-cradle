# paccradle VPS settings: domains, ports and limits. No secrets here.
#
# Copy to /etc/paccradle/vps.env (root, 0644). install.sh renders the Nginx sites
# and log rotation from it; paccradle-deploy reads the ports and limits. After a
# change, run install.sh again (Nginx) or redeploy (container limits).
# Sourced by bash: quote values with spaces.

# --- Domains (DNS A/AAAA records must point at this VPS) ---
LANDING_DOMAIN=paccradle.com
LANDING_WWW_DOMAIN=www.paccradle.com
APP_DOMAIN=app.paccradle.com
API_DOMAIN=api.paccradle.com
API_DEV_DOMAIN=api-dev.paccradle.com

# Sites install.sh configures and issue-certificates.sh requests certificates
# for: landing, app, api, api-dev. Leave one out to skip it.
NGINX_SITES="landing app api api-dev"

# Let's Encrypt account email (expiry problems, policy changes).
CERTBOT_EMAIL=ops@paccradle.com

# false if the VPS has no IPv6 (Nginx would fail to listen on [::]).
NGINX_IPV6=true

# Days Nginx logs are kept (183 ≈ six months), then deleted.
NGINX_LOG_RETENTION_DAYS=183

# --- Containers: <APP>_<ENVIRONMENT>_<SETTING> ---
# Each container publishes on 127.0.0.1:<PORT> only; Nginx is the way in.
API_PRODUCTION_PORT=8080
API_DEVELOPMENT_PORT=8081
APP_PRODUCTION_PORT=3000
LANDING_PRODUCTION_PORT=3001

API_PRODUCTION_MEMORY=768m
API_PRODUCTION_CPUS=2
API_DEVELOPMENT_MEMORY=384m
API_DEVELOPMENT_CPUS=1
APP_PRODUCTION_MEMORY=64m
APP_PRODUCTION_CPUS=0.5
LANDING_PRODUCTION_MEMORY=64m
LANDING_PRODUCTION_CPUS=0.5

# Container logs (Docker "local" driver, compressed): size per file × files kept.
CONTAINER_LOG_MAX_SIZE=20m
CONTAINER_LOG_MAX_FILES=10

# Seconds a new container has to pass its health check before the previous
# version is started again.
HEALTH_TIMEOUT_SECONDS=90

# Images kept per app and environment, for rollbacks.
KEEP_IMAGES=5

# --- System ---
# The account GitHub Actions connects as (forced command paccradle-remote).
DEPLOY_USER=deploy

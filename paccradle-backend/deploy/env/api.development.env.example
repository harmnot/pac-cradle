# development | production (production: JSON logs, HTTPS-only URLs, SMTP TLS + login required)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=7773

# --- HTTP (M1-D1) ---
# The web app's origin: the only browser origin the client API (/api/client/v1)
# answers CORS for. Required in production (https://); default http://localhost:3000.
APP_WEB_URL=https://paccradle-app.netlify.app
# The back office's origin, for the admin API (/api/admin/v1). Leave empty and no
# browser may call the admin API.
ADMIN_WEB_URL=
# Optional, default 1048576 (1 MiB, Nginx's client_max_body_size for JSON).
HTTP_BODY_LIMIT_BYTES=1048576
# Optional, default 30 (1-300): a request still running then answers 503 REQUEST_TIMEOUT.
HTTP_REQUEST_TIMEOUT_SECONDS=30
# Optional, default 600: requests per minute per client address across the API.
RATE_LIMIT_PER_MINUTE=600
# Behind Nginx this must be x-real-ip (Nginx overwrites it with the real address).
# Leave empty when nothing sits in front of the API: the peer address is used.
RATE_LIMIT_CLIENT_IP_HEADER=x-real-ip
# Optional log filter, default info (e.g. info,paccradle_backend=debug).
RUST_LOG=info

# --- Database and jobs (M1-D2) ---
# PostgreSQL. Required. A Postgres on the VPS itself is host.docker.internal.
DATABASE_URL=postgres://paccradle_dev:CHANGE_ME@host.docker.internal:5432/paccradle_dev
# Optional, default 10 (1-100): connections in the pool.
DATABASE_MAX_CONNECTIONS=10
# Optional, default true: apply new migrations at startup (they only add, so a
# rollback to the previous release still runs).
DATABASE_RUN_MIGRATIONS=true
# Optional, default 2 (0-32): background job workers in this process; 0 runs none.
JOB_WORKERS=2

# --- Backup AI for unclear photos (CLAUDE.md §5.4, L3) ---
# Tried in this order. A step with an empty key is skipped, and the worker
# moves on when a step fails, times out or runs out of quota.
# Seconds to wait for one step before trying the next.
AI_STEP_TIMEOUT_SECONDS=8

# 1. Hugging Face Inference Providers. Free accounts get no monthly credits:
#    buy credits or use PRO. The token needs "Make calls to Inference Providers".
HUGGINGFACE_TOKEN=xx_xxxxx
HUGGINGFACE_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# 2. Gemini API free tier. Never used for visitors in the EEA, the UK or
#    Switzerland: Google allows only paid Gemini for apps serving them.
GEMINI_API_KEY=xx.xxx-xxx_xxx
# Optional, default gemini-2.5-flash-lite (the free tier's largest daily quota).
GEMINI_MODEL=gemini-2.5-flash-lite
# Keep these under your project's limits on the AI Studio rate-limit page.
# The worker paces requests (1-60 per minute). After AI_REQUESTS_PER_DAY it
# moves on to fal.ai until the quota day resets (midnight Pacific time).
AI_REQUESTS_PER_MINUTE=7
AI_REQUESTS_PER_DAY=900

# 3. fal.ai, paid per call. Must be a vision model that returns boxes,
#    not an image generator.
FAL_KEY=fal_xx_xxx:xxxx
FAL_VISION_ENDPOINT=fal-ai/moondream3-preview/detect


# --- Payments (Paddle Billing) ---
# sandbox or production. API key: Paddle > Developer tools > Authentication.
# Webhook secret: the notification destination's secret key (pdl_ntfset_...),
# for a destination pointing at https://<api host>/api/webhooks/v1/paddle.
# Set Paddle's default payment link to <APP_WEB_URL>/pay (the web app opens
# Paddle.js there).
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_xxx_xxx_x
PADDLE_WEBHOOK_SECRET=pdl_xxx_xxx_xxx

# --- Object storage: capture photos (M1-D4) ---
# Cloudflare R2 through its S3 API. Create a PRIVATE bucket (no public access,
# no r2.dev URL) and an R2 API token with Object Read & Write on that bucket
# only. Photos go through the API (checked, metadata removed) and come back
# out only through signed URLs that work for 10 minutes. Belt and braces for
# the 30-day purge: add a lifecycle rule deleting objects under photos/ after
# 31 days. A bucket in the EU jurisdiction has an endpoint with .eu. in it.
# The four below go together. Leave all four empty and photos are kept in
# memory (lost at restart; their signed URLs don't open).
STORAGE_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# Optional, default auto (R2's only region).
STORAGE_REGION=auto
STORAGE_BUCKET=pacxxxx
STORAGE_ACCESS_KEY_ID=xxxxx
STORAGE_SECRET_ACCESS_KEY=xxxx
# Optional, default 30 (1-10000): vision runs one user may start per hour:
# each photo upload and each tap on the product counts. One client address may
# upload 4 times as many photos.
RATE_LIMIT_UPLOADS_PER_HOUR=30

# --- Sign-in (M1-D3) ---
# The web app must be on the same site as the API (app.paccradle.com and
# api.paccradle.com): the refresh cookie is SameSite=Strict, and browsers block
# cookies across sites anyway.
# Signs access tokens (HMAC-SHA256): at least 32 random characters, secret.
# Required: make one with openssl rand -base64 48. Changing it signs
# everyone out of their current access token (refresh cookies still work).
AUTH_JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
# Passkeys (WebAuthn) are bound to this domain: the host of APP_WEB_URL, or a
# parent domain of it and of ADMIN_WEB_URL's host (paccradle.com covers
# app.paccradle.com and admin.paccradle.com). Optional, default: APP_WEB_URL's
# host. NEVER change it after launch: every saved passkey would stop working.
WEBAUTHN_RP_ID=paccradle-app.netlify.app
# Optional, default Paccradle: the name some browsers show next to a passkey (1-64).
WEBAUTHN_RP_NAME=Paccradle
# Optional, default 20: sign-in requests (guest, email link, password, passkey)
# per minute per client address. Refresh and sign-out keep the API-wide limit.
RATE_LIMIT_AUTH_PER_MINUTE=20

# --- Email: sign-in links (M1-D3) ---
# SMTP to any provider. Development default: Mailpit from scripts/dev-mail.sh
# (127.0.0.1:1025, no TLS; read it at http://localhost:8025).
SMTP_HOST=mail.smtp2go.com
# 587 for starttls, 465 for tls.
SMTP_PORT=587
# starttls | tls (none is refused in production).
SMTP_SECURITY=starttls
# Required in production (the SMTP2GO SMTP user).
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# The sender, verified in SMTP2GO. No quotes: docker --env-file keeps them.
EMAIL_FROM=Paccradle <no-reply@paccradle.com>

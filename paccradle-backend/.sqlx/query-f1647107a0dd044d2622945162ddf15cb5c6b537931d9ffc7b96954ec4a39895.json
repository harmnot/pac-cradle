{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT id, design_version, formats, paid_with, status, created_at\n                FROM exports\n                WHERE design_id = $1 AND ($2::text IS NULL OR status = $2)\n                ORDER BY\n                    CASE WHEN $3 = 'asc' THEN created_at END ASC,\n                    CASE WHEN $3 = 'desc' THEN created_at END DESC,\n                    id\n                LIMIT $4 OFFSET $5\n                ",

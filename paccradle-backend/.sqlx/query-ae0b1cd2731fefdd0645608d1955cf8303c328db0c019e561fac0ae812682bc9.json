  "query": "\n                SELECT id, email, role, locale, paper_default,\n                       password_hash IS NOT NULL AS \"has_password!\",\n                       (SELECT count(*) FROM passkeys WHERE passkeys.user_id = users.id)\n                           AS \"passkey_count!\",\n                       created_at\n                FROM users\n                WHERE id = $1\n                ",

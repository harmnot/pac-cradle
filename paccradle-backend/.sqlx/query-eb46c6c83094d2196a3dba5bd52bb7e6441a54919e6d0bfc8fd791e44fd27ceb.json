{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT id, user_id, surface, method, authenticated_at, expires_at,\n                       revoked_at IS NOT NULL AS \"revoked!\",\n                       refresh_token_hash = $2 AS \"current!\",\n                       rotated_at\n                FROM sessions\n                WHERE surface = $1 AND (refresh_token_hash = $2 OR previous_refresh_token_hash = $2)\n                ",

{
  "db_name": "PostgreSQL",
  "query": "\n                UPDATE jobs\n                SET status = 'running',\n                    attempts = attempts + 1,\n                    locked_until = now() + make_interval(secs => $2)\n                WHERE id = (\n                    SELECT id FROM jobs\n                    WHERE status = 'queued' AND run_at <= now() AND kind = ANY($1)\n                    ORDER BY run_at, id\n                    LIMIT 1\n                    FOR UPDATE SKIP LOCKED\n                )\n                RETURNING id, kind, payload, attempts, max_attempts\n                ",
